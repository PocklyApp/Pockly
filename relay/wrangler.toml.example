name = "pockly-managed-runtime-dev"
main = "src/worker.js"
compatibility_date = "2026-06-05"

# Copy this file to wrangler.toml for a concrete environment. Keep real account
# IDs, database IDs, bucket names, and secrets out of git.

[vars]
ENVIRONMENT = "development"
REALTIME_ENABLED = "0"
TERMINAL_ENABLED = "0"
WEB_PUSH_ENABLED = "0"
STT_ENABLED = "0"
RELEASE_UPDATE_ENABLED = "0"

[[d1_databases]]
binding = "DB"
database_name = "REPLACE_ME"
database_id = "REPLACE_ME"

[[r2_buckets]]
binding = "RELEASES"
bucket_name = "REPLACE_ME"

[[durable_objects.bindings]]
name = "USER_RUNTIME"
class_name = "UserRuntimeDO"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["UserRuntimeDO"]
